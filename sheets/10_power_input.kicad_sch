			)
			(justify left bottom)
		)
		(uuid "ba779818-7f87-4dc0-a180-bb9c12cbcb78")
	)
	(text "RIELES USADOS EN ESTA HOJA: GND_VEH, GND_CAN, +VPROT (sale), +5V_VEH (pull-up de FLT)"
